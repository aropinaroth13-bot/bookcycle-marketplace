# BOOKCYCLE Environment Variables
# Copy this file to .env and fill in your actual values

# Django Settings
SECRET_KEY=django-insecure-h9e+2b%l0i3&_-h3bfalxf-zjgf7k70#3o7+xqeqb9ufr*7_fx
